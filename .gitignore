# macOS
.DS_Store

# Python
*.pyc
__pycache__/
.venv/
.pytest_cache/
.test_durations

# RAPTOR startup
.startup-output

# RAPTOR outputs
out/
.out/

# Local
.env*
.claude/*.local.json
.claude/raptor.env

# Runtime artifacts
codeql_dbs/

# User-local tuning (regenerate with: raptor tune default)
tuning.json

# SAGE (opt-in; generated by libexec/raptor-sage-setup)
.mcp.json
.sage/
*.sage.key
*.gcov

# Local scratch: copied-over repos, triage notes, ad-hoc analysis (never committed)
scratch/

# reports/: Claude Code's final, clean, human-readable deliverables.
# Contents are never committed; the folder + its README are kept so it
# exists on clone.
reports/*
!reports/README.md
